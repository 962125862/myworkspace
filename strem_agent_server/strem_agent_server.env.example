# Example config for strem_agent_server Docker entrypoint.
# Mount this file into the container and set STREM_AGENT_SERVER_ENV_FILE to point to it.
#
# Notes:
# - This file supports simple KEY=VALUE (or quoted) lines.
# - docker -e VAR=... takes precedence over this file (entrypoint won't override existing envs).

IN_HOST=0.0.0.0
IN_PORT=19000

VIDEO_BIND=0.0.0.0
VIDEO_PORT=31234

CTRL_BIND=0.0.0.0
CTRL_PORT=31235

WORKER_CTRL_IP=127.0.0.1
WORKER_CTRL_PORT=50001

# Optional: enable AUTH token for both video+ctrl connections.
AGENT_TOKEN=your-static-token

# Optional: H264 tap runtime tuning (read by strem_agent_server itself).
#H264_TAP_STALL_MS=50
#H264_TAP_DROP_IDR=0

