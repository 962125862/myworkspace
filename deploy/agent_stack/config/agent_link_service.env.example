# agent_link_service config (mounted by docker compose via env_file)
#
# Security:
# - startLink uses HMAC-SHA256 signature if AGENT_LINK_SK is set.
# - token is the static token used by both the gate and strem_agent_server.

AGENT_LINK_TOKEN=your-static-token
AGENT_LINK_SK=change-me-sk
AGENT_LINK_SIG_SKEW_SEC=60
AGENT_LINK_NONCE_TTL_SEC=300

# API (HTTP)
AGENT_LINK_API_BIND=127.0.0.1
AGENT_LINK_API_PORT=40120

# Gates (TCP)
AGENT_LINK_VIDEO_BIND=0.0.0.0
AGENT_LINK_VIDEO_PORT=40121
AGENT_LINK_CTRL_BIND=0.0.0.0
AGENT_LINK_CTRL_PORT=40122

# Upstream strem_agent_server
AGENT_LINK_AGENT_HOST=127.0.0.1
AGENT_LINK_AGENT_VIDEO_PORT=31234
AGENT_LINK_AGENT_CTRL_PORT=31235

# On-demand stop after idle (seconds). 300 = 5 minutes.
AGENT_LINK_IDLE_STOP_SEC=300

# mlctl.sh paths inside the container (repo is mounted to /repo)
AGENT_LINK_MLCTL=/repo/deploy/mlctl.sh
AGENT_LINK_WORKERS_DIR=/repo/deploy/workers

# Also set mlctl dirs explicitly (mlctl.sh reads these envs).
ML_WORKERS_DIR=/repo/deploy/workers
ML_DATA_DIR=/repo/deploy/data

