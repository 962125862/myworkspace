# strem_agent_server config (read by strem_agent_server/docker_entrypoint.sh)
#
# Token must match AGENT_LINK_TOKEN so that:
# - external clients authenticate to the gate with AGENT_LINK_TOKEN
# - the gate authenticates upstream to strem_agent_server with the same token

AGENT_TOKEN=your-static-token

IN_HOST=0.0.0.0
IN_PORT=19000

VIDEO_BIND=0.0.0.0
VIDEO_PORT=31234

CTRL_BIND=0.0.0.0
CTRL_PORT=31235

WORKER_CTRL_IP=127.0.0.1
WORKER_CTRL_PORT=30001

# Optional tuning
#H264_TAP_STALL_MS=50
#H264_TAP_DROP_IDR=0
