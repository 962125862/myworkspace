# agent_link_service 运行配置（无需源码）
#
# 作用：
# - 提供 HTTP 接口 /startLink（带签名鉴权），用于按需启动对应 stream_id 的 ml_worker 推流容器
# - 提供两个 TCP gate（video/ctrl），客户端通过 gate 连接，上游会转发到 strem_agent_server
# - 通过 gate 感知连接断开：空闲 N 秒后 stop-soft 对应 ml_worker 容器（默认 5 分钟）
#
# 注意：
# - 这里的 AGENT_LINK_TOKEN 必须和 strem_agent_server 的 AGENT_TOKEN 保持一致

AGENT_LINK_TOKEN=your-static-token

# /startLink 的签名鉴权（推荐开启）
# - 请求参数：call_name / ts / nonce / sig
# - sig = HMAC-SHA256(AGENT_LINK_SK, "call_name=startLink&stream=<id>&ts=<ts>&nonce=<nonce>") 的 hex
AGENT_LINK_SK=change-me-sk

# 时间戳允许偏差（秒），客户端机器时间不准时可以适当调大
AGENT_LINK_SIG_SKEW_SEC=60

# nonce 去重窗口（秒），用于防重放
AGENT_LINK_NONCE_TTL_SEC=300

# HTTP API（对外触发 startLink 时需要 0.0.0.0）
AGENT_LINK_API_BIND=0.0.0.0
AGENT_LINK_API_PORT=40120

# TCP gate（对客户端开放的入口）
AGENT_LINK_VIDEO_BIND=0.0.0.0
AGENT_LINK_VIDEO_PORT=40121
AGENT_LINK_CTRL_BIND=0.0.0.0
AGENT_LINK_CTRL_PORT=40122

# 上游 strem_agent_server（host network 下通常是 127.0.0.1）
AGENT_LINK_AGENT_HOST=127.0.0.1
AGENT_LINK_AGENT_VIDEO_PORT=31234
AGENT_LINK_AGENT_CTRL_PORT=31235

# 空闲停止（秒）。当某个 stream 的 video+ctrl 都断开后，等待该时间再 stop-soft 容器
# - 300 = 5 分钟
AGENT_LINK_IDLE_STOP_SEC=300

# mlctl.sh 已经打包进镜像；worker 配置/keys/data 会保存在 docker volumes 里
AGENT_LINK_MLCTL=/app/mlctl.sh
AGENT_LINK_WORKERS_DIR=/app/workers

# mlctl.sh 的目录覆盖（让它也使用同一套持久化 volume）
ML_WORKERS_DIR=/app/workers
ML_DATA_DIR=/app/data

# ml_worker 镜像（必须存在或可被 pull）
# 默认使用 GHCR 上的镜像（建议把 package 设为 public；否则需要先 docker login ghcr.io）
ML_IMAGE=ghcr.io/962125862/myworkspace/ml-worker:latest

# 串流分辨率/帧率/码率等“视频编码参数”推荐按 worker 配置（按 stream）设置：
# - `/app/workers/<worker>.conf`
#
# 也可选用“全局默认值”（仅当 worker 配置没写对应字段时才生效）：
#ML_WORKER_DEFAULT_WIDTH=1920
#ML_WORKER_DEFAULT_HEIGHT=1080
#ML_WORKER_DEFAULT_FPS=60
#ML_WORKER_DEFAULT_BITRATE=20000
#ML_WORKER_DEFAULT_PACKET_SIZE=1024
#ML_WORKER_DEFAULT_COLORSPACE=709
#ML_WORKER_DEFAULT_RANGE=limited

# 可选：让 ml_worker 容器以非 root 用户运行（Linux 上建议设置成你的 uid:gid）
#ML_DOCKER_USER=1000:1000
