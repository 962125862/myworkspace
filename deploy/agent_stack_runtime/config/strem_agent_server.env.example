# strem_agent_server 运行配置（无需源码）
#
# 作用：
# - strem_agent_server 是“代理服务端”，接收 ml_worker 推来的 H264(TLV/TCP)，对外输出 H264(TCP)，并接收控制输入(TCP)再转发给 ml_worker(UDP)。
#
# 注意：
# - 这里的 AGENT_TOKEN 必须和 agent_link_service 的 AGENT_LINK_TOKEN 保持一致，
#   否则 gate 虽然验过 token，但连接上游 strem_agent_server 时会鉴权失败。

AGENT_TOKEN=your-static-token

# ingest（ml_worker 推流到这里）
IN_HOST=0.0.0.0
IN_PORT=19000

# video 输出（客户端 SUB 拉流）
VIDEO_BIND=0.0.0.0
VIDEO_PORT=31234

# control 输入（客户端发键鼠控制）
CTRL_BIND=0.0.0.0
CTRL_PORT=31235

# strem_agent_server 把控制包 UDP 转发到 ml_worker 的控制端口（通常同机 127.0.0.1 即可）
WORKER_CTRL_IP=127.0.0.1
WORKER_CTRL_PORT=30001

# 可选：tap 行为调参（一般不用改）
#H264_TAP_STALL_MS=50
#H264_TAP_DROP_IDR=0
