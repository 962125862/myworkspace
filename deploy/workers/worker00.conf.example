# ml_worker 配置文件示例 (TCP推流版本)
# 位置: deploy/workers/worker00.conf

HOST="192.168.11.50"
APP="Desktop"
IMAGE="ml-worker:latest"
WORKER_BIN=""

# TCP推流配置
TCP_HOST="127.0.0.1"
TCP_PORT="9000"
STREAM_ID="1"

# 控制端口配置
CONTROL_BIND="127.0.0.1"
CONTROL_PORT="50001"

# 视频参数
WIDTH="1280"
HEIGHT="720"
FPS="60"
BITRATE="10000"
PACKET_SIZE="1024"
COLORSPACE="709"
RANGE="limited"
CODEC="h264"
CHROMA="420"
BITDEPTH="8"

# Sunshine 可能不返回 supported modes（常见于部分 VM），默认建议跳过校验。
SKIP_MODE_CHECK="1"
