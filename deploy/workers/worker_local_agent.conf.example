# Example worker config for local testing with strem_agent_server

HOST="192.168.11.50"
APP="Desktop"
IMAGE="ml-worker:latest"
WORKER_BIN=""

# Push TLV/H264 to local strem_agent_server
TCP_HOST="127.0.0.1"
TCP_PORT="19000"
STREAM_ID="1"

# ml_worker local UDP control socket (agent_server forwards control to this)
CONTROL_BIND="127.0.0.1"
CONTROL_PORT="50001"

# Video params
WIDTH="1280"
HEIGHT="720"
FPS="60"
BITRATE="10000"
PACKET_SIZE="1024"
COLORSPACE="709"
RANGE="limited"
CODEC="h264"
CHROMA="420"
BITDEPTH="8"

# Sunshine 可能不返回 supported modes（常见于部分 VM），默认建议跳过校验。
SKIP_MODE_CHECK="1"
